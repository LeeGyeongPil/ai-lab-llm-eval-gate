# 값은 비워 둔다. 필요한 것만 셸에서 export 한다(예: export EVALGATE_MODEL=qwen3:4b). .env 파일은 자동으로 읽지 않는다.
# 우선순위: 명령행 옵션 > 환경변수 > evalgate.toml
EVALGATE_MODE=            # mock(기본) / real / record
EVALGATE_BASE_URL=        # OpenAI 호환 엔드포인트. 기본 http://localhost:11434/v1 (Ollama)
EVALGATE_API_KEY=         # 엔드포인트 키. Ollama 는 아무 값이나 가능
EVALGATE_MODEL=           # 피평가 모델. 기본 qwen3:4b
EVALGATE_JUDGE_MODEL=     # 심판 모델. 비우면 EVALGATE_MODEL 과 같음
EVALGATE_EMBED_MODEL=     # 임베딩 모델. 기본 bge-m3
EVALGATE_WORKERS=         # 동시 요청 수. 기본 2
EVALGATE_TIMEOUT=         # 요청당 제한 시간(초). 기본 300
